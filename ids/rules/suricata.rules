# ICMP Detection
alert icmp any any -> any any (msg:"ICMP Ping Detected"; sid:1000001; rev:1;)

# HTTP Traffic Detection
alert http any any -> any any (msg:"HTTP Traffic Detected"; flow:established,to_server; sid:1000002; rev:1;)

# SSH Brute Force Detection
alert tcp any any -> any 22 (msg:"Possible SSH Brute Force Attempt"; flags:S; threshold:type threshold, track by_src, count 5, seconds 60; sid:1000003; rev:1;)

# DNS Query Detection
alert dns any any -> any any (msg:"DNS Query Detected"; sid:1000004; rev:1;)

# Suspicious Port Scan
alert tcp any any -> any any (msg:"Possible Port Scan"; flags:S; threshold:type threshold, track by_src, count 20, seconds 10; sid:1000005; rev:1;)
