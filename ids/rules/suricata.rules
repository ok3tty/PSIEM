# ICMP Detection
alert icmp any any -> any any (msg:"ICMP Ping Detected"; classtype:misc-activity; sid:1000001; rev:2;)

# SSH Brute Force Detection
alert tcp any any -> any 22 (msg:"Possible SSH Brute Force Attempt"; classtype:attempted-admin; flags:S; threshold:type threshold, track by_src, count 5, seconds 60; sid:1000003; rev:2;)

# DNS Query Detection
alert dns any any -> any any (msg:"DNS Query Detected"; classtype:misc-activity; sid:1000004; rev:2;)

# Suspicious Port Scan
alert tcp any any -> any any (msg:"Possible Port Scan"; classtype:attempted-recon; flags:S; threshold:type threshold, track by_src, count 20, seconds 10; sid:1000005; rev:2;)
